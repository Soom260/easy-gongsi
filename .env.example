# 내 컴퓨터에서 테스트할 때만 씁니다.
# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 커밋되지 않아요)
# GitHub에서는 Secrets(DART_API_KEY)와 Variables(SHEET_..._CSV_URL)에 넣습니다.
DART_API_KEY=
# 시트 주소 대신 파일 경로를 적으면 그 파일을 읽어요. 예: sample-sheets/companies.csv
SHEET_DICT_CSV_URL=
SHEET_TERMS_CSV_URL=
SHEET_COMPANIES_CSV_URL=
# 테스트용: 다룰 회사 수 (0이면 전체)
LIMIT=0
